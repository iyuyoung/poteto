---
import Layout from '../layouts/Layout.astro';
import { PotetoAuditApp } from '../components/PotetoAuditApp';
import { getDailyAuditPayload, getDatabaseUrl } from '../lib/db';
import { getUtcDateString } from '../lib/prng';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://poteto.fun').replace(/\/$/, '');
const todayUtc = getUtcDateString();
const initialDaily = await getDailyAuditPayload(todayUtc, getDatabaseUrl(Astro.locals));

const faqs = [
  {
    q: 'Poteto 人类资格年审是什么？需要注册账号吗？',
    a: 'Poteto 是一款免注册、零登录门槛的每日荒诞互动网页小游戏。每天 UTC 00:00 全球玩家会收到完全一致的 3 关题目，你需要在 90 秒内完成测试，与来自北海道的对照组土豆（Poteto #01）比拼“人类纯度”，并自动获得带手绘证件照的《人类资格鉴定书》。',
  },
  {
    q: '每天的三关年审分别考什么？为什么大家刷到的题一样？',
    a: '我们使用基于 UTC 日期的确定性随机种子（Deterministic Seed），保证全球玩家同一天刷到的题库完全一致：第 1 关辨别昨日网友手绘的矢量土豆与官方干扰项；第 2 关从 16 个反直觉交互微关卡中每日轮换抽取（连续 7 天以上不重复）；第 3 关用 8 秒 3 笔手绘当日荒诞命题土豆，作为证件照并进入明日全球候选池。',
  },
  {
    q: '我画的土豆会被存成图片吗？隐私和数据安全如何保障？',
    a: '不会保存任何 PNG/JPEG 像素图片。画作在浏览器端会被归一化至 0–100 整数坐标系，并通过 Ramer-Douglas-Peucker 算法压缩为仅 300–600 字节的纯矢量坐标 JSON，使用匿名本地 UUID 关联次日回访战报，不收集姓名、手机号或任何个人敏感信息。',
  },
  {
    q: '开放手绘 UGC 如何防止出现不雅图形或垃圾涂鸦？',
    a: 'Poteto 采用三层防滥用机制：第一层前端硬约束（最多 3 笔、8 秒限时、粗笔触、第 1 笔闭合度与 0.5–2.0 长宽比校验）；第二层“次日精选池”隔离，当日画作不会实时公开展出，经每日精选审核后才进入次日九宫格；第三层众包熔断，任何画作累计被举报 3 次即自动隐藏并由备选池无缝顶替。',
  },
  {
    q: '完成今日年审后还能继续玩吗？',
    a: '可以！今日全球同题年审完成后会为你锁定成绩和连胜纪录，你可以在鉴定书下方直接点击「进入无尽年审（Endless Mode）」，无限随机挑战全部 16 个反直觉微关卡和社区灵魂画作。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Poteto 人类资格年审',
    url: siteUrl,
    inLanguage: 'zh-CN',
    description: '零登录门槛的每日 90 秒人类资格年审网页小游戏，与北海道对照组土豆同场竞技。',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Poteto — 每日人类资格年审',
    url: siteUrl,
    genre: ['Casual', 'Puzzle', 'Comedy'],
    playMode: 'SinglePlayer',
    applicationCategory: 'Game',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'CNY',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<Layout
  title="Poteto 人类资格年审 — 90秒证明你比一颗北海道土豆更像人类"
  description="免注册、零门槛的每日全球同题网页小游戏。点击“我不是机器人”，挑战 3 关荒诞反直觉测试与 8 秒手绘土豆，生成你的专属人类资格鉴定书。"
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Above-the-fold: The Audit Game Itself -->
  <section class="mx-auto max-w-4xl px-4 pb-10 pt-8 sm:px-6 sm:pt-12">
    <PotetoAuditApp client:load initialDaily={initialDaily} siteUrl={siteUrl} />
  </section>

  <!-- Below-the-fold: Editorial How-It-Works Strip -->
  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6" aria-labelledby="how-it-works-heading">
    <div class="rounded-3xl border border-[#E2D9C8] bg-white/90 p-6 shadow-xs sm:p-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
        <div>
          <span class="font-mono text-xs font-bold tracking-wider text-[#C86D2D] uppercase">
            DAILY 3-STAGE PROTOCOL
          </span>
          <h2 id="how-it-works-heading" class="mt-1 font-display text-2xl font-bold text-[#1C1917]">
            90 秒三关全球同题年审机制
          </h2>
        </div>
        <span class="font-mono text-xs text-[#78716C]">UTC 00:00 全球同步刷新</span>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-[#EFE8DA] bg-[#FAF7F0] p-4">
          <div class="font-mono text-xs font-bold text-[#C86D2D]">01 · 视觉 / UGC 辨别</div>
          <h3 class="mt-1.5 font-display text-base font-bold text-[#1C1917]">从九宫格识破灵魂土豆</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[#57534E]">
            每日按确定性种子抽取昨日精选的 8 张网友矢量画作与 1 张官方干扰项，测试你的审美与共情力。
          </p>
        </article>

        <article class="rounded-2xl border border-[#EFE8DA] bg-[#FAF7F0] p-4">
          <div class="font-mono text-xs font-bold text-[#C86D2D]">02 · 反直觉搞心态</div>
          <h3 class="mt-1.5 font-display text-base font-bold text-[#1C1917]">16 套微交互轮番上阵</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[#57534E]">
            5 秒不动鼠标、会分裂的数土豆、躲避光标的按钮……对照组土豆靠一动不动轻松躺赢。
          </p>
        </article>

        <article class="rounded-2xl border border-[#EFE8DA] bg-[#FAF7F0] p-4">
          <div class="font-mono text-xs font-bold text-[#C86D2D]">03 · 手绘自证入库</div>
          <h3 class="mt-1.5 font-display text-base font-bold text-[#1C1917]">8 秒 3 笔生成专属证件照</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[#57534E]">
            RDP 矢量压缩仅占 300–600 字节，直接印在你的鉴定书上，并有机会成为明天的全球考题。
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Semantic FAQ Module (GEO & SEO) -->
  <section id="faq" class="mx-auto max-w-4xl px-4 py-6 sm:px-6" aria-labelledby="faq-heading">
    <div class="mb-5">
      <span class="font-mono text-xs font-bold tracking-wider text-[#78716C] uppercase">
        FREQUENTLY ASKED QUESTIONS
      </span>
      <h2 id="faq-heading" class="mt-1 font-display text-2xl font-bold text-[#1C1917]">
        常见问题解答
      </h2>
    </div>

    <div class="space-y-2.5">
      {faqs.map((item, idx) => (
        <div class="collapse collapse-plus rounded-2xl border border-[#E2D9C8] bg-white">
          <input type="radio" name="poteto-faq" checked={idx === 0} />
          <h3 class="collapse-title font-display text-base font-bold text-[#1C1917]">
            {item.q}
          </h3>
          <div class="collapse-content text-sm leading-relaxed text-[#57534E]">
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
