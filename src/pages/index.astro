---
import Layout from '../layouts/Layout.astro';
import { PotetoAuditApp } from '../components/PotetoAuditApp';
import { getDailyAuditPayload, getDatabaseUrl } from '../lib/db';
import { getUtcDateString } from '../lib/prng';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://poteto.fun').replace(/\/$/, '');
const todayUtc = getUtcDateString();
const initialDaily = await getDailyAuditPayload(todayUtc, getDatabaseUrl(Astro.locals));

const faqs = [
  {
    q: 'What is Poteto? Do I need an account to play?',
    a: 'Poteto is a zero-login, 90-second daily CAPTCHA comedy game. Every day at UTC 00:00, everyone on Earth faces the exact same 3-stage audit against an unbothered Idaho control potato (Spud #01) and receives a custom Human License Certificate featuring their own sketch.',
  },
  {
    q: 'What happens in the 3 daily stages?',
    a: 'Stage 1 tests your instincts on yesterday\'s community-drawn vector potatoes (plus 1 sneaky fake rock). Stage 2 rotates through 16 unhinged anti-intuition mini-games with zero repeats across 16 days. Stage 3 gives you 10 seconds and 4 strokes to sketch a prompt potato that becomes your ID photo—and tomorrow\'s puzzle.',
  },
  {
    q: 'How are sketches stored and moderated without image bloat?',
    a: 'We never store PNG or JPEG files. Every doodle is normalized to a 0–100 integer grid and compressed via Ramer-Douglas-Peucker into 300–600 bytes of pure vector JSON. Moderation runs in three layers: strict stroke/timer/loop checks upfront, next-day curated pool isolation, and automatic 3-flag community takedowns.',
  },
  {
    q: 'Can I keep playing after finishing today\'s audit?',
    a: 'Yes! Once today\'s global daily audit is archived with your streak, hit "Enter Endless Mode" on your certificate to shuffle through all 16 mini-games and community potato prompts indefinitely.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Poteto — Daily Human Audit',
    url: siteUrl,
    inLanguage: 'en',
    description: 'Zero-login 90-second daily CAPTCHA comedy game where you prove you are smarter than an Idaho potato.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Poteto — Daily Human Audit',
    url: siteUrl,
    genre: ['Casual', 'Puzzle', 'Comedy'],
    playMode: 'SinglePlayer',
    applicationCategory: 'Game',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<Layout
  title="Poteto — Daily 90-Second Human Audit vs. an Idaho Potato"
  description="No login required. Check 'I'm not a robot' to beat an unbothered Idaho potato across 3 absurd CAPTCHA stages and earn your laminated Human License."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Centerpiece: Full Focus Interactive Stage -->
  <section class="mx-auto flex min-h-[72vh] max-w-3xl flex-col items-center justify-center px-4 py-3 sm:px-6">
    <PotetoAuditApp client:load initialDaily={initialDaily} siteUrl={siteUrl} />
  </section>

  <!-- Unobtrusive Below-the-Fold FAQ (Collapsed by default, SEO/GEO intact) -->
  <section id="faq" class="mx-auto max-w-xl px-4 pt-12 sm:px-6" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 text-center font-display text-xs font-semibold tracking-wider text-[#71717A] uppercase">
      Daily Audit · FAQ
    </h2>
    <div class="divide-y divide-[#E4E4E7] overflow-hidden rounded-2xl border border-[#E4E4E7] bg-white">
      {faqs.map((item) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-[#18181B]">
            <span>{item.q}</span>
            <span class="ml-3 font-mono text-xs text-[#A1A1AA] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2.5 text-xs leading-relaxed text-[#52525B]">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</Layout>
