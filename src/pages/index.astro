---
import Layout from '../layouts/Layout.astro';
import { PotetoAuditApp } from '../components/PotetoAuditApp';
import { getDailyAuditPayload, getDatabaseUrl } from '../lib/db';
import { getUtcDateString } from '../lib/prng';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://poteto.fun').replace(/\/$/, '');
const todayUtc = getUtcDateString();
const initialDaily = await getDailyAuditPayload(todayUtc, getDatabaseUrl(Astro.locals));

const faqs = [
  {
    q: 'Poteto 人类资格年审是什么？需要注册吗？',
    a: '免注册、零门槛的 90 秒每日网页小游戏。每天 UTC 00:00 全球玩家收到完全一致的 3 关题目，与北海道对照组土豆（Poteto #01）比拼人类纯度，完成后自动生成带手绘证件照的《人类资格鉴定书》。',
  },
  {
    q: '每天的三关分别考什么？',
    a: '第 1 关辨别昨日网友手绘的矢量土豆与官方伪装项；第 2 关挑战每日轮换的 16 套反直觉微交互（连续 16 天不重复）；第 3 关用 10 秒 4 笔手绘当日荒诞命题土豆，既作证件照又成为明天的全球考题。',
  },
  {
    q: '手绘土豆是如何存储与防滥用的？',
    a: '不存任何图片，浏览器端将笔画归一化为 0–100 整数坐标并用 Ramer-Douglas-Peucker 算法压到 300–600 字节。配合前端 4 笔/限时/闭合度约束、次日精选池审核隔离，以及满 3 次举报自动熔断替换。',
  },
  {
    q: '做完今天还能继续玩吗？',
    a: '可以。今日全球同题完成后会自动锁定成绩与连胜，在鉴定书下方点击「无尽年审」即可无限随机挑战全部 16 套微交互与社区画作。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Poteto 人类资格年审',
    url: siteUrl,
    inLanguage: 'zh-CN',
    description: '零登录门槛的每日 90 秒人类资格年审网页小游戏，与北海道对照组土豆同场竞技。',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Poteto — 每日人类资格年审',
    url: siteUrl,
    genre: ['Casual', 'Puzzle', 'Comedy'],
    playMode: 'SinglePlayer',
    applicationCategory: 'Game',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'CNY',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<Layout
  title="Poteto 人类资格年审 — 90秒证明你比一颗北海道土豆更像人类"
  description="免注册、零门槛的每日全球同题网页小游戏。点击“我不是机器人”，挑战 3 关荒诞反直觉测试与手绘土豆，生成你的专属人类资格鉴定书。"
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Centerpiece: Full Focus Interactive Stage -->
  <section class="mx-auto flex min-h-[78vh] max-w-3xl flex-col items-center justify-center px-4 py-6 sm:px-6">
    <PotetoAuditApp client:load initialDaily={initialDaily} siteUrl={siteUrl} />
  </section>

  <!-- Unobtrusive Below-the-Fold FAQ (Collapsed by default, SEO/GEO intact) -->
  <section id="faq" class="mx-auto max-w-xl px-4 pt-12 sm:px-6" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 text-center font-display text-sm font-semibold tracking-wider text-[#71717A] uppercase">
      关于每日年审 · FAQ
    </h2>
    <div class="divide-y divide-[#E4E4E7] overflow-hidden rounded-2xl border border-[#E4E4E7] bg-white">
      {faqs.map((item) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-[#18181B]">
            <span>{item.q}</span>
            <span class="ml-3 font-mono text-xs text-[#A1A1AA] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2.5 text-xs leading-relaxed text-[#52525B]">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</Layout>
