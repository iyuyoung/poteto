---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://poteto.fun').replace(/\/$/, '');
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@poteto.fun';

const {
  title,
  description,
  canonicalPath = '/',
  jsonLd,
} = Astro.props;

const canonicalUrl = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const ogImageUrl = `${siteUrl}/og-image.png`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAFAFB" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Poteto 人类资格年审" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    {jsonLdList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col text-[#09090B]">
    <!-- Ultra-minimal Floating Top Bar -->
    <header class="w-full">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="group flex items-center gap-2.5">
          <img
            src="/logo.svg"
            alt="Poteto"
            width="28"
            height="28"
            class="h-7 w-7 rounded-lg shadow-xs transition-transform group-hover:scale-105"
          />
          <span class="font-display text-sm font-bold tracking-tight text-[#09090B]">
            Poteto
          </span>
        </a>

        <nav aria-label="主导航" class="flex items-center gap-5 text-xs font-medium text-[#71717A]">
          <a href="/#faq" class="transition-colors hover:text-[#09090B]">规则</a>
          <a href="/about" class="transition-colors hover:text-[#09090B]">关于</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Minimal Single-Line Footer -->
    <footer class="mt-20 border-t border-[#E4E4E7]/80 bg-white/60">
      <div class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-3 px-4 py-6 text-xs text-[#71717A] sm:flex-row sm:px-6">
        <p>
          Poteto 人类资格年审 ·
          <a
            href={`mailto:${contactEmail}`}
            class="font-mono text-[#18181B] underline decoration-[#D4D4D8] underline-offset-4 hover:decoration-[#1A73E8]"
          >
            {contactEmail}
          </a>
        </p>
        <div class="flex items-center gap-5">
          <a href="/about" class="hover:text-[#09090B]">关于</a>
          <a href="/privacy" class="hover:text-[#09090B]">隐私</a>
          <a href="/terms" class="hover:text-[#09090B]">条款</a>
        </div>
      </div>
    </footer>
  </body>
</html>
