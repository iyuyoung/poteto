{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poteto",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://poteto.fun",
    "PUBLIC_CONTACT_EMAIL": "hello@poteto.fun"
  }
}
